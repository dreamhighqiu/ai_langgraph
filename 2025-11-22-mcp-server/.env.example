# RAG Anything MCP Server 配置示例

# ==========================================
# LLM 配置
# ==========================================

# LLM API 密钥
LLM_API_KEY=your_api_key_here

# LLM API 基础 URL（支持 OpenAI 兼容的 API）
LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 模型名称
LLM_MODEL=deepseek-chat

# ==========================================
# 视觉模型配置（可选）
# ==========================================

# 视觉模型 API 密钥（如果不设置，将使用 LLM_API_KEY）
VISION_API_KEY=your_vision_api_key

# 视觉模型 API 基础 URL（如果不设置，将使用 LLM_BASE_URL）
VISION_BASE_URL=https://api.openai.com/v1

# 视觉模型名称（例如：gpt-4-vision, gpt-4o）
VISION_MODEL=gpt-4o

# ==========================================
# 嵌入模型配置
# ==========================================

# 使用 Ollama 嵌入（推荐用于本地部署）
USE_OLLAMA_EMBEDDING=true

# Ollama 服务器地址
EMBEDDING_HOST=http://localhost:11434

# Ollama 嵌入模型名称
EMBEDDING_MODEL=qwen3-embedding:0.6b

# 嵌入维度
EMBEDDING_DIM=1024

# ==========================================
# RAG 存储配置
# ==========================================

# RAG 工作目录（存储知识库）
RAG_WORKING_DIR=./rag_storage

# 文档解析器（mineru 或 docling）
RAG_PARSER=docling

# 解析方法（auto, ocr, txt）
RAG_PARSE_METHOD=auto

# ==========================================
# 多模态处理配置
# ==========================================

# 启用图像处理
RAG_ENABLE_IMAGE=true

# 启用表格处理
RAG_ENABLE_TABLE=true

# 启用公式处理
RAG_ENABLE_EQUATION=true

# ==========================================
# 知识库加载配置
# ==========================================

# 是否加载已存在的知识库
LOAD_EXISTING=true

# ==========================================
# 服务器配置
# ==========================================

# MCP 服务器端口（SSE 模式）
MCP_PORT=8002

# MCP 服务器主机
MCP_HOST=0.0.0.0

