# Backend Dockerfile for LangGraph Service
FROM python:3.13-slim

WORKDIR /app

# Configure Debian mirror for better network access (use Aliyun mirror in China)
# Try multiple methods to ensure compatibility with different Debian versions
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list || \
        sed -i 's|https://deb.debian.org|https://mirrors.aliyun.com|g' /etc/apt/sources.list || true; \
    fi

# Install system dependencies including curl for healthchecks and Node.js
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (try multiple methods for reliability)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get update && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* || \
    (echo "Node.js 通过 apt 安装失败，尝试直接下载..." && \
     curl -fsSL https://nodejs.org/dist/v20.11.0/node-v20.11.0-linux-x64.tar.xz -o /tmp/node.tar.xz && \
     tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
     rm /tmp/node.tar.xz && \
     ln -sf /usr/local/bin/node /usr/bin/node && \
     ln -sf /usr/local/bin/npm /usr/bin/npm && \
     ln -sf /usr/local/bin/npx /usr/bin/npx) || \
    (echo "警告: Node.js 安装失败，如果不需要 stdio MCP 服务可以继续" && true)

# Configure pip to use mirror and increase timeout
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.timeout 300 && \
    pip config set global.retries 5

# Install uv for faster package installation
RUN pip install --no-cache-dir --timeout=300 uv || \
    (pip install --no-cache-dir --timeout=300 -i https://mirrors.aliyun.com/pypi/simple/ uv)

# Copy dependency files
COPY requirements.txt ./
COPY anything-chat-rag/pyproject.toml anything-chat-rag/setup.py ./anything-chat-rag/
COPY anything-chat-rag/lightrag ./anything-chat-rag/lightrag/
COPY anything-chat-rag/raganything ./anything-chat-rag/raganything/

# Install Python dependencies (with retry and timeout)
# 优先使用 pip，避免 uv 可能的卡顿问题
RUN pip install --timeout=300 --retries=5 -r requirements.txt || \
    (pip install --timeout=300 --retries=5 -i https://mirrors.aliyun.com/pypi/simple/ -r requirements.txt) || \
    (echo "尝试使用 uv..." && uv pip install --system -r requirements.txt)

# Install LightRAG in editable mode (with retry and timeout)
# 优先使用 pip，避免 uv 可能的卡顿问题
RUN pip install --timeout=300 --retries=5 -e ./anything-chat-rag || \
    (pip install --timeout=300 --retries=5 -i https://mirrors.aliyun.com/pypi/simple/ -e ./anything-chat-rag) || \
    (echo "尝试使用 uv..." && uv pip install --system -e ./anything-chat-rag)

# Copy application code
COPY testing-agents-service/ ./testing-agents-service/
COPY deepagents/ ./deepagents/

# Install automation_quality MCP service dependencies (stdio mode)
WORKDIR /app/testing-agents-service/mcp/automation_quality
RUN if [ -f "package.json" ]; then \
        npm config set registry https://registry.npmmirror.com || true; \
        npm install --production || \
        (npm config set registry https://registry.npmjs.org && npm install --production); \
    fi
WORKDIR /app

# Set Python path
ENV PYTHONPATH=/app/testing-agents-service:/app:$PYTHONPATH

# Expose only LangGraph port
EXPOSE 2025

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:2025/ok || exit 1

# Default command
CMD ["python", "testing-agents-service/start_server.py", "--host", "0.0.0.0", "--port", "2025"]

