# ================================
# RuoYi-Vue3-FastAPI 环境配置模板
# 复制此文件为 .env.dev 或 .env.prod 使用
# cp env.example .env.dev
# ================================

# ========== 应用配置 ==========
APP_ENV=dev
APP_NAME=AI智能测试平台
APP_ROOT_PATH=/dev-api
APP_HOST=0.0.0.0
APP_PORT=9099
APP_VERSION=1.0.0
APP_RELOAD=true
APP_IP_LOCATION_QUERY=true
APP_SAME_TIME_LOGIN=true

# ========== JWT配置 ==========
JWT_SECRET_KEY=b01c66dc2c58dc6a0aabfe2144256be36226de378bf87f72c0c795dda67f4d55
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30

# ========== 数据库配置 ==========
# 数据库类型: mysql 或 postgresql
DB_TYPE=mysql
# 远程服务器地址
DB_HOST=47.110.95.246
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123456
DB_DATABASE=ai_db
DB_ECHO=false
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=50
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# ========== Redis配置 ==========
# 远程服务器地址
REDIS_HOST=47.110.95.246
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=redis123456
REDIS_DATABASE=2

# ========== MinIO对象存储配置 ==========
# 远程服务器地址
MINIO_ENDPOINT=47.110.95.246:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-testing
MINIO_SECURE=false

# ========== Milvus向量数据库配置 ==========
# 远程服务器地址
MILVUS_HOST=47.110.95.246
MILVUS_PORT=19530
MILVUS_COLLECTION=test_knowledge

# ========== LangGraph AI服务配置 ==========
# 本地开发时LangGraph服务在本地运行
LANGGRAPH_API_URL=http://127.0.0.1:2025
LANGGRAPH_API_KEY=

# ========== Ollama AI模型配置 ==========
# 远程服务器地址
OLLAMA_HOST=http://47.110.95.246:11434
OLLAMA_MODEL=qwen2.5:7b

# ========== OpenAI兼容配置 ==========
OPENAI_API_KEY=
OPENAI_API_BASE=http://47.110.95.246:11434/v1
OPENAI_MODEL=qwen2.5:7b

# ========== 本地存储路径(无MinIO时使用) ==========
LOCAL_STORAGE_PATH=./storage

# ========== K6 执行配置 ==========
# k6 可执行文件路径（已加入 PATH 可填 k6，否则填写 k6.exe 绝对路径）
K6_BINARY=k6
# k6 工作空间根目录（脚本/结果都会写到此目录下的子目录）
K6_WORKSPACE_ROOT=./k6_workspace
# 脚本虚拟目录（无需改动，一致用 /k6_scripts）
K6_SCRIPTS_DIR=/k6_scripts
# 结果虚拟目录（无需改动，一致用 /k6_results）
K6_RESULTS_DIR=/k6_results
# 默认并发与时长（可按需调整）
K6_DEFAULT_VUS=10
K6_DEFAULT_DURATION=1m
