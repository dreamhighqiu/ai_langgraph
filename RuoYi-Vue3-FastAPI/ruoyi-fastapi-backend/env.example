# ================================
# RuoYi-Vue3-FastAPI 环境配置模板
# 复制此文件为 .env.dev 或 .env.prod 使用
# cp env.example .env.dev
# ================================

# ========== 应用配置 ==========
APP_ENV=dev
APP_NAME=RuoYi-FastAPI
APP_ROOT_PATH=/dev-api
APP_HOST=0.0.0.0
APP_PORT=9099
APP_VERSION=1.0.0
APP_RELOAD=true
APP_IP_LOCATION_QUERY=true
APP_SAME_TIME_LOGIN=true

# ========== JWT配置 ==========
JWT_SECRET_KEY=b01c66dc2c58dc6a0aabfe2144256be36226de378bf87f72c0c795dda67f4d55
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30

# ========== 数据库配置 ==========
# 数据库类型: mysql 或 postgresql
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=mysqlroot
DB_DATABASE=ruoyi-fastapi
DB_ECHO=false
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=50
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# ========== Redis配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=2

# ========== MinIO对象存储配置 ==========
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-testing
MINIO_SECURE=false

# ========== Milvus向量数据库配置 ==========
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=test_knowledge

# ========== LangGraph AI服务配置 ==========
LANGGRAPH_API_URL=http://127.0.0.1:2025
LANGGRAPH_API_KEY=

# ========== Ollama AI模型配置 ==========
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ========== OpenAI兼容配置 ==========
OPENAI_API_KEY=
OPENAI_API_BASE=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:7b

# ========== 本地存储路径(无MinIO时使用) ==========
LOCAL_STORAGE_PATH=./storage

