# 娴嬭瘯绠＄悊绯荤粺鐜鍙橀噺閰嶇疆绀轰緥
# 澶嶅埗姝ゆ枃浠朵负 .env 骞朵慨鏀归厤缃?
# alembic upgrade head

# 搴旂敤閰嶇疆
APP_NAME=娴嬭瘯绠＄悊绯荤粺
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL 鏁版嵁搴撻厤缃?
# 濡傛灉鍚庣鍦?Docker 瀹瑰櫒涓繍琛岋紝浣跨敤鏈嶅姟鍚?postgres
# 濡傛灉鍚庣鍦ㄥ涓绘満杩愯锛屼娇鐢?localhost
POSTGRES_HOST=47.110.95.246
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ai_db

# MongoDB 鏁版嵁搴撻厤缃?
MONGODB_HOST=121.40.159.60
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=ai_test_management

# 閫熺巼闄愬埗閰嶇疆
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=60

# 鍒嗛〉閰嶇疆
PAGINATION_DEFAULT_SIZE=30
PAGINATION_MAX_SIZE=300

# CORS 閰嶇疆锛圝SON 鏍煎紡鐨勫煙鍚嶅垪琛級
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]

# API 鍓嶇紑
API_PREFIX=/api/v2

# MinIO 瀵硅薄瀛樺偍閰嶇疆
# 濡傛灉鍚庣鍦?Docker 瀹瑰櫒涓繍琛岋紝浣跨敤鏈嶅姟鍚?minio:9000
# 濡傛灉鍚庣鍦ㄥ涓绘満杩愯锛屼娇鐢?localhost:9000
MINIO_ENDPOINT=47.110.95.246:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=test-management
MINIO_SECURE=false
MINIO_REGION=

# 闄勪欢閰嶇疆
ATTACHMENT_MAX_SIZE=52428800  # 50 MB

# # ========== LangGraph API 鏈嶅姟閰嶇疆 ==========
# # Graph API 鏈嶅姟涓绘満鍦板潃
LANGGRAPH_HOST=0.0.0.0

# # Graph API 鏈嶅姟绔彛鍙?
LANGGRAPH_PORT=2026

# Graph API 鏈嶅姟瀹屾暣 URL锛堝彲閫夛紝濡傛灉涓嶈缃細鑷姩浠?LANGGRAPH_HOST 鍜?LANGGRAPH_PORT 鏋勫缓锛?
# LANGGRAPH_API_URL=http://localhost:2026
