# 测试管理系统环境变量配置示例
# 复制此文件为 .env 并修改配�?
# alembic upgrade head

# 应用配置
APP_NAME=测试管理系统
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL 数据库配�?
# 如果后端�?Docker 容器中运行，使用服务�?postgres
# 如果后端在宿主机运行，使�?localhost
POSTGRES_HOST=47.110.95.246
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ai_db

# MongoDB 数据库配�?
MONGODB_HOST=121.40.159.60
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=ai_test_management

# 速率限制配置
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=60

# 分页配置
PAGINATION_DEFAULT_SIZE=30
PAGINATION_MAX_SIZE=300

# CORS 配置（JSON 格式的域名列表）
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]

# API 前缀
API_PREFIX=/api/v2

# MinIO 对象存储配置
# 如果后端�?Docker 容器中运行，使用服务�?minio:9000
# 如果后端在宿主机运行，使�?localhost:9000
MINIO_ENDPOINT=47.110.95.246:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=test-management
MINIO_SECURE=false
MINIO_REGION=

# 附件配置
ATTACHMENT_MAX_SIZE=52428800  # 50 MB

# # ========== LangGraph API 服务配置 ==========
# # Graph API 服务主机地址
LANGGRAPH_HOST=0.0.0.0

# # Graph API 服务端口�?
LANGGRAPH_PORT=2026

# Graph API 服务完整 URL（可选，如果不设置会自动�?LANGGRAPH_HOST �?LANGGRAPH_PORT 构建�?
# LANGGRAPH_API_URL=http://localhost:2026
