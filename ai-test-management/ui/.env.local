# LangGraph API Configuration
# LangGraph API 的基础 URL
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2025

# LangGraph API 的端口号
NEXT_PUBLIC_LANGGRAPH_API_PORT=2025

# 测试用例生成智能体的 ID
NEXT_PUBLIC_TESTCASE_GENERATOR_ASSISTANT_ID=testcase_generator_agent

# LangSmith API Key (可选，用于追踪和调试)
NEXT_PUBLIC_LANGSMITH_API_KEY=

# 后端 API 配置
NEXT_PUBLIC_API_URL=http://localhost:8080

