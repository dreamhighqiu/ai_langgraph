  <data key="d1">organization</data>
  <data key="d2">金融行业是本培训课程的目标学员所在领域，包括银行、保险、证券等机构。</data>
  <data key="d3">chunk-6c9699f6be450b7bab348fd80cc8c912</data>
  <data key="d4">llm_course.pdf</data>
  <data key="d5">1764232890</data>
  <data key="d6"></data>
</node>
