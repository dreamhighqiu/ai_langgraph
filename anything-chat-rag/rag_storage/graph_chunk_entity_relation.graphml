  <data key="d0">用户打卡数据</data>
  <data key="d1">data</data>
  <data key="d2">用户记录的每日健康指标数据，包括关键指标总结和详细健康指标。</data>
  <data key="d3">chunk-6f413192b6712442310ab83e47795227</data>
  <data key="d4">文档.txt</data>
  <data key="d5">1767969883</data>
  <data key="d6"></data>
</node>
<node id="关键指标总结">
  <data key="d0">关键指标总结</data>
  <data key="d1">data</data>
  <data key="d2">打卡数据中的汇总部分，包括每日消耗卡路里、累计消耗卡路里、每日摄入卡路里、累计摄入卡路里、每日睡眠时间、累计睡眠时间。</data>
  <data key="d3">chunk-6f413192b6712442310ab83e47795227</data>
  <data key="d4">文档.txt</data>
  <data key="d5">1767969885</data>
  <data key="d6"></data>
</node>
