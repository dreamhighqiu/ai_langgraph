  <data key="d5">1767073886</data>
  <data key="d6"></data>
</node>
<node id="Rasa">
  <data key="d0">Rasa</data>
  <data key="d1">organization</data>
  <data key="d2">Rasa是一个用于构建基于NLU的助手的框架，版本为3.6.21。&lt;SEP&gt;Rasa是一个用于构建对话式AI的开源框架。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54&lt;SEP&gt;chunk-0ed01d0a52df8896f87835c170a4127f</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073886</data>
  <data key="d6"></data>
</node>
<node id="rasa train --finetune">
  <data key="d0">rasa train --finetune</data>
  <data key="d1">method</data>
  <data key="d2">这是一个Rasa命令行命令，用于对已训练好的模型进行增量训练或微调。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073893</data>
  <data key="d6"></data>
</node>
<node id="增量训练">
  <data key="d0">增量训练</data>
  <data key="d1">method</data>
  <data key="d2">增量训练是一种模型训练方法，使用现有模型作为基础，在新的训练数据上进行微调以提高性能。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073893</data>
  <data key="d6"></data>
</node>
<node id="查找表">
  <data key="d0">查找表</data>
  <data key="d1">data</data>
  <data key="d2">查找表是添加到训练数据中的额外信息，用于帮助模型正确识别意图和实体。&lt;SEP&gt;查找表是正则表达式实体提取器用于匹配和提取实体的数据源。&lt;SEP&gt;查找表是RegexEntityExtractor组件使用的一种特征，用于基于预定义列表匹配和提取实体。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54&lt;SEP&gt;chunk-e0b0e1c4d631cf0610d16ca55817ac01&lt;SEP&gt;chunk-0ed01d0a52df8896f87835c170a4127f</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073893</data>
  <data key="d6"></data>
</node>
<node id="自定义组件">
  <data key="d0">自定义组件</data>
  <data key="d1">method</data>
  <data key="d2">自定义组件是用户根据特定需求开发的Rasa NLU管道组件，需遵循特定格式。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073897</data>
  <data key="d6"></data>
</node>
<node id="jieba_tokenizer.py">
  <data key="d0">jieba_tokenizer.py</data>
  <data key="d1">artifact</data>
  <data key="d2">jieba_tokenizer.py是一个文件，作为开发Rasa自定义分词器组件的参考格式。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073901</data>
  <data key="d6"></data>
</node>
<node id="标签集">
  <data key="d0">标签集</data>
  <data key="d1">data</data>
  <data key="d2">标签集指训练数据中定义的意图和实体的集合，增量训练要求标签集保持不变。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
