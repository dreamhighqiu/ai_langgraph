  <data key="d6"></data>
</node>
<node id="case_sensitive">
  <data key="d0">case_sensitive</data>
  <data key="d1">concept</data>
  <data key="d2">case_sensitive是RegexEntityExtractor组件的一个配置参数，用于控制文本匹配是否区分大小写，默认值为False。&lt;SEP&gt;case_sensitive是正则表达式实体提取器的配置参数，指示文本处理是否区分大小写，在示例中设置为False。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54&lt;SEP&gt;chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073908</data>
  <data key="d6"></data>
</node>
<node id="use_lookup_tables">
  <data key="d0">use_lookup_tables</data>
  <data key="d1">concept</data>
  <data key="d2">use_lookup_tables是RegexEntityExtractor组件的一个配置参数，用于启用或禁用查找表进行实体提取。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073908</data>
  <data key="d6"></data>
</node>
<node id="use_regexes">
  <data key="d0">use_regexes</data>
  <data key="d1">concept</data>
  <data key="d2">use_regexes是RegexEntityExtractor组件的一个配置参数，用于启用或禁用正则表达式进行实体提取。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073911</data>
  <data key="d6"></data>
</node>
<node id="use_word_boundaries">
  <data key="d0">use_word_boundaries</data>
  <data key="d1">concept</data>
  <data key="d2">use_word_boundaries是RegexEntityExtractor组件的一个配置参数，用于控制在查找表匹配时是否使用词边界。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073911</data>
  <data key="d6"></data>
</node>
<node id="--epoch-fraction">
  <data key="d0">--epoch-fraction</data>
  <data key="d1">concept</data>
  <data key="d2">--epoch-fraction是`rasa train --finetune`命令的一个参数，用于指定微调时使用的迭代次数比例。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073914</data>
  <data key="d6"></data>
</node>
<node id="CDD">
  <data key="d0">CDD</data>
  <data key="d1">method</data>
  <data key="d2">CDD(Conversation-Driven Development)是一种开发实践，根据用户与助手的交互方式来改进模型。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073914</data>
  <data key="d6"></data>
</node>
<node id="nlu">
  <data key="d0">nlu</data>
  <data key="d1">concept</data>
  <data key="d2">nlu(Natural Language Understanding)是Rasa框架中负责理解用户意图和提取实体的模块。</data>
  <data key="d3">chunk-c0dd04808417ed9e3c6f74d1e54d5a54</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073914</data>
  <data key="d6"></data>
</node>
<node id="DIET分类器">
  <data key="d0">DIET分类器</data>
  <data key="d1">method</data>
  <data key="d2">DIET分类器是一种用于意图分类和实体识别的组件，它需要来自特征提取器的分词输入和特征，并在Transformer层前独立处理序列和句子特征。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073915</data>
  <data key="d6"></data>
</node>
<node id="LogisticRegressionClassifier">
  <data key="d0">LogisticRegressionClassifier</data>
  <data key="d1">method</data>
  <data key="d2">逻辑回归分类器使用scikit-learn实现，用于意图分类，支持稀疏和密集特征，训练速度快，可作为轻量级基准。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073916</data>
  <data key="d6"></data>
</node>
<node id="SklearnIntentClassifier">
  <data key="d0">SklearnIntentClassifier</data>
  <data key="d1">method</data>
  <data key="d2">Sklearn意图分类器训练一个线性SVM模型，使用网格搜索进行优化，用于意图分类。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073919</data>
  <data key="d6"></data>
</node>
<node id="特征提取器">
  <data key="d0">特征提取器</data>
  <data key="d1">method</data>
  <data key="d2">特征提取器为DIET分类器等组件提供分词输入和特征，是管道中的必要组成部分。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073925</data>
  <data key="d6"></data>
</node>
<node id="稠密特征">
  <data key="d0">稠密特征</data>
  <data key="d1">data</data>
  <data key="d2">稠密特征是多种分类器和提取器(如逻辑回归分类器、Sklearn意图分类器、CRF实体提取器)所依赖的特征类型。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073925</data>
  <data key="d6"></data>
</node>
<node id="条件随机场">
  <data key="d0">条件随机场</data>
  <data key="d1">method</data>
  <data key="d2">条件随机场是CRF实体提取器使用的机器学习方法，用于命名实体识别。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073931</data>
  <data key="d6"></data>
</node>
<node id="线性SVM">
  <data key="d0">线性SVM</data>
  <data key="d1">method</data>
  <data key="d2">线性SVM是Sklearn意图分类器使用的机器学习模型，用于意图分类。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073931</data>
  <data key="d6"></data>
</node>
<node id="网格搜索">
  <data key="d0">网格搜索</data>
  <data key="d1">method</data>
  <data key="d2">网格搜索是Sklearn意图分类器用于优化模型超参数的方法。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073936</data>
  <data key="d6"></data>
</node>
<node id="BILOU标记">
  <data key="d0">BILOU标记</data>
  <data key="d1">method</data>
  <data key="d2">BILOU标记是CRF实体提取器使用的一种标记方案，用于实体识别。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073936</data>
  <data key="d6"></data>
</node>
<node id="Transformer层">
  <data key="d0">Transformer层</data>
  <data key="d1">method</data>
  <data key="d2">Transformer层是DIET分类器架构的一部分，用于处理序列特征。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073936</data>
  <data key="d6"></data>
</node>
<node id="FFNN层">
  <data key="d0">FFNN层</data>
  <data key="d1">method</data>
  <data key="d2">FFNN层是DIET分类器中的前馈神经网络层，与DenseForSparse层之间可应用Dropout。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073938</data>
  <data key="d6"></data>
</node>
<node id="DenseForSparse层">
  <data key="d0">DenseForSparse层</data>
  <data key="d1">method</data>
  <data key="d2">DenseForSparse层是DIET分类器中的层，用于处理稀疏到稠密的转换，与FFNN层之间可应用Dropout。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073939</data>
  <data key="d6"></data>
</node>
<node id="Dropout">
  <data key="d0">Dropout</data>
  <data key="d1">method</data>
  <data key="d2">Dropout是一种正则化技术，在DIET分类器中可通过参数在FFNN层与DenseForSparse层之间控制。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073942</data>
  <data key="d6"></data>
</node>
<node id="训练步数">
  <data key="d0">训练步数</data>
  <data key="d1">data</data>
  <data key="d2">训练步数是一个配置参数，在示例配置中设置为100个epochs。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073946</data>
  <data key="d6"></data>
</node>
<node id="学习率">
  <data key="d0">学习率</data>
  <data key="d1">data</data>
  <data key="d2">学习率是一个配置参数，在示例配置中设置为0.001。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073946</data>
  <data key="d6"></data>
</node>
<node id="use_dense_input_dropout">
  <data key="d0">use_dense_input_dropout</data>
  <data key="d1">data</data>
  <data key="d2">use_dense_input_dropout是一个布尔型配置参数，用于控制是否在DIET分类器的FFNN层与DenseForSparse层之间应用Dropout。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073949</data>
  <data key="d6"></data>
</node>
<node id="checkpoint_model">
  <data key="d0">checkpoint_model</data>
  <data key="d1">data</data>
  <data key="d2">checkpoint_model是一个布尔型配置参数，指示是否在训练过程中保存模型检查点。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073949</data>
  <data key="d6"></data>
</node>
<node id="evaluate_on_number_of_examples">
  <data key="d0">evaluate_on_number_of_examples</data>
  <data key="d1">data</data>
  <data key="d2">evaluate_on_number_of_examples是一个配置参数，指定用于评估的示例数量，在示例中设置为100。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073952</data>
  <data key="d6"></data>
</node>
<node id="max_iter">
  <data key="d0">max_iter</data>
  <data key="d1">data</data>
  <data key="d2">max_iter是逻辑回归分类器的配置参数，表示最大迭代次数，在示例中设置为100。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073952</data>
  <data key="d6"></data>
</node>
<node id="solver">
  <data key="d0">solver</data>
  <data key="d1">data</data>
  <data key="d2">solver是逻辑回归分类器的配置参数，表示求解器类型，在示例中设置为'lbfgs'。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073952</data>
  <data key="d6"></data>
</node>
<node id="tol">
  <data key="d0">tol</data>
  <data key="d1">data</data>
  <data key="d2">tol是逻辑回归分类器的配置参数，表示优化器停止标准的容限，在示例中设置为0.0001。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073953</data>
  <data key="d6"></data>
</node>
<node id="random_state">
  <data key="d0">random_state</data>
  <data key="d1">data</data>
  <data key="d2">random_state是逻辑回归分类器的配置参数，用于在训练前打乱数据，在示例中设置为42。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073955</data>
  <data key="d6"></data>
</node>
<node id="ranking_length">
  <data key="d0">ranking_length</data>
  <data key="d1">data</data>
  <data key="d2">ranking_length是逻辑回归分类器的配置参数，指定意图排名的长度，在示例中设置为10。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073962</data>
  <data key="d6"></data>
</node>
<node id="C">
  <data key="d0">C</data>
  <data key="d1">data</data>
  <data key="d2">C是Sklearn意图分类器的配置参数，是用于C-SVM交叉验证的正则化值列表。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073968</data>
  <data key="d6"></data>
</node>
<node id="kernels">
  <data key="d0">kernels</data>
  <data key="d1">data</data>
  <data key="d2">kernels是Sklearn意图分类器的配置参数，指定用于C-SVM的内核类型列表，在示例中为["linear"]。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073968</data>
  <data key="d6"></data>
</node>
<node id="gamma">
  <data key="d0">gamma</data>
  <data key="d1">data</data>
  <data key="d2">gamma是Sklearn意图分类器的配置参数，表示C-SVM的Gamma参数，在示例中设置为[0.1]。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073975</data>
  <data key="d6"></data>
</node>
<node id="max_cross_validation_folds">
  <data key="d0">max_cross_validation_folds</data>
  <data key="d1">data</data>
  <data key="d2">max_cross_validation_folds是Sklearn意图分类器的配置参数，指定交叉验证的折数，在示例中设置为5。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073975</data>
  <data key="d6"></data>
</node>
<node id="scoring_function">
  <data key="d0">scoring_function</data>
  <data key="d1">data</data>
  <data key="d2">scoring_function是Sklearn意图分类器的配置参数，指定评估函数，在示例中设置为"f1_weighted"。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073983</data>
  <data key="d6"></data>
</node>
<node id="BILOU_flag">
  <data key="d0">BILOU_flag</data>
  <data key="d1">data</data>
  <data key="d2">BILOU_flag是CRF实体提取器的配置参数，指示是否使用BILOU标记，在示例中设置为True。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073983</data>
  <data key="d6"></data>
</node>
<node id="features">
  <data key="d0">features</data>
  <data key="d1">data</data>
  <data key="d2">features是CRF实体提取器的配置参数，指定滑动窗口中要提取的特征列表。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073983</data>
  <data key="d6"></data>
</node>
<node id="L1_c">
  <data key="d0">L1_c</data>
  <data key="d1">data</data>
  <data key="d2">L1_c是CRF实体提取器的配置参数，表示L1正则化的权重，在示例中设置为0.1。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073984</data>
  <data key="d6"></data>
</node>
<node id="L2_c">
  <data key="d0">L2_c</data>
  <data key="d1">data</data>
  <data key="d2">L2_c是CRF实体提取器的配置参数，表示L2正则化的权重，在示例中设置为0.1。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073988</data>
  <data key="d6"></data>
</node>
<node id="featurizers">
  <data key="d0">featurizers</data>
  <data key="d1">data</data>
  <data key="d2">featurizers是CRF实体提取器的配置参数，指定要使用的稠密特征提取器名称列表，如果为空则使用所有可用特征。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073993</data>
  <data key="d6"></data>
</node>
<node id="split_entities_by_comma">
  <data key="d0">split_entities_by_comma</data>
  <data key="d1">data</data>
  <data key="d2">split_entities_by_comma是CRF实体提取器的配置参数，指示是否将提取出的实体列表按给定实体类型拆分为单个实体。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073999</data>
  <data key="d6"></data>
</node>
<node id="token">
  <data key="d0">token</data>
  <data key="d1">data</data>
  <data key="d2">token是CRF实体提取器所依赖的输入数据，代表分词后的文本单元。</data>
  <data key="d3">chunk-e0b0e1c4d631cf0610d16ca55817ac01</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073999</data>
  <data key="d6"></data>
</node>
<node id="text_dense_feature">
