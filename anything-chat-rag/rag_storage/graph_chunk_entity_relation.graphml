  <data key="d0">LanguageModelFeaturizer</data>
  <data key="d1">method</data>
  <data key="d2">使用预训练语言模型为用户消息创建向量表示，输出密集特征，用于实体提取、意图分类和创建特征。</data>
  <data key="d3">chunk-e2a73219a6b81a765a98ce10205dfeb7</data>
  <data key="d4">操作步骤1.md</data>
  <data key="d5">1767073820</data>
  <data key="d6"></data>
</node>
