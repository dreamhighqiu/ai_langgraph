<node id="隐私协议">
  <data key="d0">隐私协议</data>
  <data key="d1">content</data>
  <data key="d2">隐私协议是用于算法备案和官网的法律文档，规定了数据使用和保护条款。</data>
  <data key="d3">chunk-e3c13875720cef2444bbacaa549d5b1d</data>
