<node id="ProjectModel">
  <data key="d0">ProjectModel</data>
  <data key="d1">artifact</data>
  <data key="d2">ProjectModel是后端定义的数据模型类，用于表示项目信息，包含project_id、project_name等字段。</data>
  <data key="d3">chunk-9b24edb7e56cd76dd6ec67a60020f6c5</data>
