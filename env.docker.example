# ========== LLM Configuration ==========
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://us.api.openai.com/v1

# ========== LightRAG WebUI Public Access (Optional) ==========
# 留空则自动检测服务器地址（推荐）
# 如果需要指定特殊 URL，取消下面的注释并修改
# LIGHTRAG_API_URL=http://your-server-ip:9621
# 示例：
# LIGHTRAG_API_URL=http://192.168.1.100:9621  # 局域网
# LIGHTRAG_API_URL=http://your-domain.com:9621  # 公网域名
# LIGHTRAG_API_URL=https://your-domain.com:9621  # HTTPS

# ========== LightRAG Configuration ==========
LIGHTRAG_BASE_URL=http://lightrag:9621
RAG_WORKING_DIR=/app/rag_storage

# ========== Vector Database ==========
MILVUS_URI=milvus:19530
MILVUS_DB_NAME=lightrag

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ========== MySQL ==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ai_db
MYSQL_USER=aiuser
MYSQL_PASSWORD=ai123456

# ========== PostgreSQL (Optional - for --profile full) ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ai_db

# ========== LangGraph ==========
LANGGRAPH_PORT=2025
LANGGRAPH_HOST=0.0.0.0

# ========== Frontend ==========
NEXT_PUBLIC_LANGGRAPH_URL=http://localhost:2025


