2a\u51fa\u73b0  \n    \n\n[6] \u7528\u4f8b\u6807\u9898\uff1a\u4fee\u6539\u4e0e\u5220\u9664\u8d44\u91d1\u8bb0\u5f55\u529f\u80fd\u6d4b\u8bd5  \n**\u7528\u4f8b\u63cf\u8ff0**\uff1a\u9a8c\u8bc1\u8d44\u91d1\u660e\u7ec6\u7684\u4fee\u6539\u4e0e\u5220\u9664\u529f\u80fd\uff0c\u53ef\u6b63\u786e\u66f4\u65b0\u5c55\u793a\u53ca\u540c\u6b65\u7edf\u8ba1\u603b\u989d\u3002  \n**\u6d4b\u8bd5\u7c7b\u578b**\uff1a\u529f\u80fd\u6d4b\u8bd5  \n**\u4f18\u5148\u7ea7**\uff1a\u9ad8  \n**\u7528\u4f8b\u72b6\u6001**\uff1a\u672a\u5f00\u59cb  \n**\u9700\u6c42ID**\uff1a31  \n**\u9879\u76eeID**\uff1a3  \n**\u521b\u5efa\u8005**\uff1a\u7cfb\u7edf  \n**\u524d\u7f6e\u6761\u4ef6**\uff1a  \n- \u65e5\u8bb0\u4e2d\u5df2\u5b58\u5728\u591a\u6761\u8d44\u91d1\u8bb0\u5f55  \n    \n**\u540e\u7f6e\u6761\u4ef6**\uff1a  \n- \u8d44\u91d1\u660e\u7ec6\u53ca\u603b\u6d88\u8d39\u91d1\u989d\u968f\u64cd\u4f5c\u52a8\u6001\u53d8\u5316  \n    \n**\u6d4b\u8bd5\u6b65\u9aa4**\uff1a  \n- \u6b65\u9aa41\uff1a  \n    - [\u6b65\u9aa4\u63cf\u8ff0]\uff1a\u9009\u62e9\u4e00\u6761\u8d44\u91d1\u8bb0\u5f55\uff08\u5982\uff1a20.00\u5143-\u4ea4\u901a\uff09\uff0c\u70b9\u51fb\u201c\u7f16\u8f91\u201d\uff0c\u4fee\u6539\u91d1\u989d\u4e3a\u201c30.00\u201d\uff0c\u6807\u7b7e\u4e3a\u201c\u706b\u8f66\u201d\uff0c\u4fdd\u5b58  \n    - [\u9884\u671f\u7ed3\u679c]\uff1a\u8bb0\u5f55\u66f4\u65b0\u4e3a\u201c30.00\u5143-\u706b\u8f66\u201d\uff0c\u603b\u91d1\u989d\u636e\u5b9e\u53d8\u66f4  \n- \u6b65\u9aa42\uff1a  \n    - [\u6b65\u9aa4\u63cf\u8ff0]\uff1a\u9009\u62e9\u4efb\u610f\u4e00\u6761\u8d44\u91d1\u8bb0\u5f55\uff0c\u70b9\u51fb\u201c\u5220\u9664\u201d\u5e76\u786e\u8ba4  \n    - [\u9884\u671f\u7ed3\u679c]\uff1a\u8be5\u6761\u660e\u7ec6\u4ece\u5c55\u793a\u533a\u57df\u79fb\u9664\u4e14\u603b\u91d1\u989d\u6263\u51cf\u76f8\u5e94\u91d1\u989d  \n    \n\n[7] \u7528\u4f8b\u6807\u9898\uff1a\u8d44\u91d1\u660e\u7ec6\u5f55\u5165\u64cd\u4f5c\u7684\u81ea\u52a8\u5316\u517c\u5bb9\u6027\u6d4b\u8bd5  \n**\u7528\u4f8b\u63cf\u8ff0**\uff1a\u9a8c\u8bc1\u8d44\u91d1\u5f55\u5165\u3001\u7f16\u8f