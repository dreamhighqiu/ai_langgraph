fdd\u6301\u6807\u9898\u4e0e\u6b63\u6587\u4e3a\u7a7a\u7684\u60c5\u51b5\u4e0b\u70b9\u51fb\u201c\u4fdd\u5b58\u201d\u6309\u94ae\u3002\n    - [\u9884\u671f\u7ed3\u679c]\uff1a\u5f39\u7a97\u63d0\u793a\u201c\u6807\u9898\u6216\u6b63\u6587\u4e0d\u80fd\u4e3a\u7a7a\u201d\uff0c\u672a\u8df3\u8f6c\u9875\u9762\uff0c\u65e5\u8bb0\u672a\u88ab\u4fdd\u5b58\u3002\n\n---\n\n[9] \u7528\u4f8b\u6807\u9898\uff1a\u4e0d\u540c\u7ec8\u7aef\u521b\u5efa\u4e0e\u7f16\u8f91\u65c5\u884c\u65e5\u8bb0\u6570\u636e\u4e00\u81f4\u6027\u9a8c\u8bc1  \n**\u7528\u4f8b\u63cf\u8ff0**\uff1a\u9a8c\u8bc1\u7528\u6237\u5728Web\u7aef\u521b\u5efa\u5e76\u7f16\u8f91\u65e5\u8bb0\u540e\uff0c\u79fb\u52a8\u7aefApp\u53ef\u89c1\u76f8\u540c\u5185\u5bb9\u4e14\u652f\u6301\u518d\u6b21\u7f16\u8f91\uff0c\u4fdd\u8bc1\u6570\u636e\u540c\u6b65\u4e00\u81f4\u6027\u3002  \n**\u6d4b\u8bd5\u7c7b\u578b**\uff1a\u529f\u80fd\u6d4b\u8bd5  \n**\u4f18\u5148\u7ea7**\uff1a\u4e2d  \n**\u7528\u4f8b\u72b6\u6001**\uff1a\u672a\u5f00\u59cb  \n**\u9700\u6c42ID**\uff1a28  \n**\u9879\u76eeID**\uff1a3  \n**\u521b\u5efa\u8005**\uff1a\u7cfb\u7edf  \n**\u524d\u7f6e\u6761\u4ef6**\uff1a\n- \u7528\u6237\u5728Web\u7aef\u5df2\u767b\u5f55\n- \u540c\u4e00\u8d26\u53f7\u53ef\u5728Web\u53caApp\u7aef\u767b\u5f55\n- \u65e5\u8bb0\u5df2\u5728Web\u7aef\u521b\u5efa\u5e76\u7f16\u8f91  \n\n**\u540e\u7f6e\u6761\u4ef6**\uff1a\n- \u76f8\u540c\u65e5\u8bb0\u5185\u5bb9\u5728Web/App\u7aef\u4fdd\u6301\u4e00\u81f4\uff0c\u65e0\u5185\u5bb9\u4e22\u5931  \n\n**\u6d4b\u8bd5\u6b65\u9aa4**\uff1a\n- \u6b65\u9aa41\uff1a  \n    - [\u6b65\u9aa4\u63cf\u8ff0]\uff1a\u5728Web\u7aef\u65b0\u5efa\u4e00\u7bc7\u5305\u542b\u5bcc\u6587\u672c\u3001\u56fe\u7247\u53ca\u9644\u4ef6\u7684\u65e5\u8bb0\u5e76\u4fdd\u5b58\u3002  \n    - [\u9884\u671f\u7ed3\u679c]\uff1aWeb\u7aef\u65e5\u8bb0\u8be6\u60c5\u9875\u5b8c\u6574\u5c55\u793a\u5168\u90e8\u5185\u5bb9\u3002\n- \u6b65\u9aa42\uff1a  \n    - [\u6b65\u9aa4\u63cf\u8ff0]\uff1a\u7528\u540c\u8d26\u53f7\u767b\u5f55App\u7aef\uff0c\u8fdb\u5165\u65e5\u8bb0\u5185\u5bb9\u7ba1\u7406\u6