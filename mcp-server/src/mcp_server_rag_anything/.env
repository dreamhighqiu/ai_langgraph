# RAG Anything MCP Server 配置

# 工作目录：指向已使用 Milvus 的 LightRAG 存储目录
RAG_WORKING_DIR=../../anything-chat-rag/rag_storage

# LLM 配置
LLM_API_KEY=sk-0292e5a35e064f6f86169a20e39f0749
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型（可选）
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815

# 向量嵌入配置（默认 Ollama）
EMBEDDING_HOST=http://47.110.95.246:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# 解析器配置
RAG_PARSER=docling
RAG_PARSE_METHOD=auto

# 功能开关
RAG_ENABLE_IMAGE=true
RAG_ENABLE_TABLE=true
RAG_ENABLE_EQUATION=true
LOAD_EXISTING=true
USE_OLLAMA_EMBEDDING=true

# Milvus 向量存储（确保走 Milvus 而非本地存储）
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
VECTOR_STORAGE=MilvusVectorDBStorage
MILVUS_URI=http://47.110.95.246:19530
MILVUS_DB_NAME=lightrag

# 明确指定 docling 解析（避免默认 mineru）
RAG_PARSER=docling
