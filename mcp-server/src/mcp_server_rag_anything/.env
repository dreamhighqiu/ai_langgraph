# RAG Anything MCP Server 配置文件
# 复制此文件为 .env 并填入您的配置值

# ==========================================
# 工作目录配置
# ==========================================
RAG_WORKING_DIR=./rag_storage

# ==========================================
# LLM 模型配置
# ==========================================
LLM_API_KEY=sk-0292e5a35e064f6f86169a20e39f0749
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ==========================================
# 视觉模型配置（可选）
# ==========================================
# 如果未设置，将使用 LLM 的配置
VISION_API_KEY=2f1bf8e9-5df0-49d8-91cf-a3887d30a48d
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815

# ==========================================
# 嵌入模型配置
# ==========================================
# Ollama 嵌入模型配置（推荐用于本地部署）
EMBEDDING_HOST=http://47.110.95.246:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# 或使用 OpenAI 嵌入模型
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ==========================================
# 解析器配置
# ==========================================
# 解析器选择: mineru 或 docling
RAG_PARSER=docling

# 解析方法: auto, ocr 或 txt
RAG_PARSE_METHOD=auto

# ==========================================
# 功能开关
# ==========================================
RAG_ENABLE_IMAGE=true
RAG_ENABLE_TABLE=true
RAG_ENABLE_EQUATION=true

# ==========================================
# 文档处理配置（可选）
# ==========================================
# 要处理的文档路径
DOCUMENT_PATH=旅行日记2.pdf

# 新文档路径（用于加载已有知识库时添加新文档）
NEW_DOCUMENT_PATH=new_document.pdf

# 输出目录
OUTPUT_DIR=./output

# 是否启用交互式查询模式
ENABLE_INTERACTIVE=false

# ==========================================
# MCP 服务器配置
# ==========================================
# 是否加载已存在的知识库（默认: true）
LOAD_EXISTING=true

# 是否使用 Ollama 嵌入（默认: true）
USE_OLLAMA_EMBEDDING=true

# ==========================================
# 不同服务商的配置示例
# ==========================================

# OpenAI 配置示例
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4
# VISION_MODEL=gpt-4-vision-preview
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# DeepSeek 配置示例
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 火山引擎（豆包）视觉模型配置示例
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_API_KEY=your-doubao-api-key
# VISION_MODEL=doubao-seed-1-6-vision-250815

# Azure OpenAI 配置示例
# LLM_API_KEY=your-azure-key
# LLM_BASE_URL=https://your-resource.openai.azure.com/
# LLM_MODEL=gpt-4

# 本地 Ollama 配置示例
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama2
# EMBEDDING_HOST=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

