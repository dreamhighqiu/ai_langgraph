<node id="Dhamek Stupa">
  <data key="d0">Dhamek Stupa</data>
  <data key="d1">location</data>
  <data key="d2">Dhamek Stupa是位于印度鹿野苑的一座著名历史建筑，是图像背景中的主要古迹。</data>
  <data key="d3">chunk-ad9b804e4d092eef91aaf50f76f409a8</data>
  <data key="d4">旅行日记2.pdf</data>
  <data key="d5">1764559477</data>
  <data key="d6"></data>
</node>
<node id="Sarnath">
  <data key="d0">Sarnath</data>
  <data key="d1">location</data>
  <data key="d2">Sarnath是印度的一个地点，Dhamek Stupa位于此地。</data>
  <data key="d3">chunk-ad9b804e4d092eef91aaf50f76f409a8</data>
  <data key="d4">旅行日记2.pdf</data>
  <data key="d5">1764559478</data>
  <data key="d6"></data>
</node>
<node id="India">
  <data key="d0">India</data>
  <data key="d1">location</data>
