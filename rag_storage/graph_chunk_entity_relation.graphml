  <data key="d0">天空</data>
  <data key="d1">naturalobject</data>
  <data key="d2">天空呈现出鲜艳的蓝色，带有缕缕云彩，天气晴朗，自然光线强烈，能见度高。</data>
  <data key="d3">chunk-f42d21f98a63828af004d656796b0d0b</data>
  <data key="d4">旅行日记2.pdf</data>
  <data key="d5">1764559490</data>
  <data key="d6"></data>
</node>
