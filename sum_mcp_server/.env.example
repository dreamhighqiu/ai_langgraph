# ===== Ports (override if needed) =====
LIGHTRAG_API_PORT=9621

SERVER_PORT=8001
SERVER_HOST=0.0.0.0

RAG_MCP_PORT=8002
LOGIN_MCP_PORT=8003
TEST_EXECUTOR_MCP_PORT=8004
PYTEST_GENERATOR_MCP_PORT=8005
ANYTHING_RAG_MCP_PORT=8006
MINDMAP_MCP_PORT=8007

# ===== LightRAG API =====
LIGHTRAG_API_KEY=

# ===== Anything RAG HTTP MCP (wrapper -> LightRAG API) =====
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_TIMEOUT=60.0

# ===== RAG Anything MCP (raganything + lightrag) =====
# Use "auto" to avoid requiring docling/mineru; set "docling" if you installed it.
RAG_PARSER=auto
RAG_PARSE_METHOD=auto
RAG_WORKING_DIR=./rag_storage

# LLM provider config used by RAG Anything MCP
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
