{
  "version": 1,
  "purpose": "Unified MCP management for this monorepo",
  "services": [
    {
      "id": "lightrag_api",
      "name": "LightRAG API (anything-chat-rag)",
      "type": "python",
      "transport": "http",
      "default_port": 9621,
      "port_env": "LIGHTRAG_API_PORT",
      "entrypoint": "sum_mcp_server/servers/lightrag_api.py",
      "args": ["--host", "0.0.0.0", "--port", "{port}"],
      "pid_file": ".pids/lightrag_api.pid",
      "log_file": "logs/lightrag_api.log",
      "health_url": "http://127.0.0.1:{port}/docs"
    },
    {
      "id": "rag_anything",
      "name": "RAG Anything MCP (mcp-server)",
      "type": "python",
      "transport": "sse",
      "default_port": 8001,
      "port_env": "SERVER_PORT",
      "depends_on": ["lightrag_api"],
      "entrypoint": "sum_mcp_server/servers/rag_anything_mcp.py",
      "args": ["--sse", "--host", "0.0.0.0", "--port", "{port}"],
      "pid_file": ".pids/rag_anything_mcp.pid",
      "log_file": "logs/rag_anything_mcp.log",
      "env": {
        "RAG_PARSER": "auto",
        "RAG_PARSE_METHOD": "auto",
        "RAG_WORKING_DIR": "./rag_storage"
      }
    },
    {
      "id": "api_rag",
      "name": "LightRAG RAG MCP (api_agent)",
      "type": "python",
      "transport": "sse",
      "default_port": 8002,
      "port_env": "RAG_MCP_PORT",
      "depends_on": ["lightrag_api"],
      "entrypoint": "sum_mcp_server/servers/api_rag_mcp.py",
      "args": ["--sse", "--port", "{port}"],
      "pid_file": ".pids/rag_mcp.pid",
      "log_file": "logs/rag_mcp.log",
      "env": {
        "LIGHTRAG_BASE_URL": "http://127.0.0.1:{lightrag_api.port}",
        "LIGHTRAG_API_KEY": "",
        "LIGHTRAG_TIMEOUT": "60.0"
      }
    },
    {
      "id": "api_login",
      "name": "Fecmall Login MCP (api_agent)",
      "type": "python",
      "transport": "sse",
      "default_port": 8003,
      "port_env": "LOGIN_MCP_PORT",
      "entrypoint": "sum_mcp_server/servers/api_login_mcp.py",
      "args": ["--sse", "--port", "{port}"],
      "pid_file": ".pids/login_mcp.pid",
      "log_file": "logs/login_mcp.log"
    },
    {
      "id": "api_test_executor",
      "name": "Test Executor MCP (api_agent)",
      "type": "python",
      "transport": "sse",
      "default_port": 8004,
      "port_env": "TEST_EXECUTOR_MCP_PORT",
      "entrypoint": "sum_mcp_server/servers/api_test_executor_mcp.py",
      "args": ["--sse", "--port", "{port}"],
      "pid_file": ".pids/test_executor_mcp.pid",
      "log_file": "logs/test_executor_mcp.log"
    },
    {
      "id": "api_pytest_generator",
      "name": "Pytest Generator MCP (api_agent)",
      "type": "python",
      "transport": "sse",
      "default_port": 8005,
      "port_env": "PYTEST_GENERATOR_MCP_PORT",
      "entrypoint": "sum_mcp_server/servers/api_pytest_generator_mcp.py",
      "args": ["--sse", "--port", "{port}", "--output-dir", "generated_tests"],
      "pid_file": ".pids/pytest_generator_mcp.pid",
      "log_file": "logs/pytest_generator_mcp.log"
    },
    {
      "id": "anything_rag_http",
      "name": "Anything RAG MCP (LightRAG HTTP wrapper)",
      "type": "python",
      "transport": "sse",
      "default_port": 8006,
      "port_env": "ANYTHING_RAG_MCP_PORT",
      "depends_on": ["lightrag_api"],
      "entrypoint": "sum_mcp_server/servers/anything_rag_http_mcp.py",
      "args": ["--transport", "sse", "--host", "0.0.0.0", "--port", "{port}"],
      "pid_file": ".pids/anything_rag_mcp.pid",
      "log_file": "logs/anything_rag_mcp.log",
      "env": {
        "LIGHTRAG_BASE_URL": "http://127.0.0.1:{lightrag_api.port}",
        "LIGHTRAG_API_KEY": "",
        "LIGHTRAG_TIMEOUT": "60.0"
      }
    },
    {
      "id": "mindmap",
      "name": "MindMap MCP",
      "type": "python",
      "transport": "sse",
      "default_port": 8007,
      "port_env": "MINDMAP_MCP_PORT",
      "entrypoint": "sum_mcp_server/servers/mindmap_mcp_server.py",
      "args": ["--sse", "--host", "0.0.0.0", "--port", "{port}"],
      "pid_file": ".pids/mindmap_mcp.pid",
      "log_file": "logs/mindmap_mcp.log"
    },
    {
      "id": "automation_quality",
      "name": "Automation Quality MCP (Node, stdio)",
      "type": "node",
      "transport": "stdio",
      "auto_start": false,
      "entrypoint": "sum_mcp_server/servers/automation_quality_mcp.js",
      "pid_file": ".pids/automation_quality_mcp.pid",
      "log_file": "logs/automation_quality_mcp.log"
    }
  ]
}
