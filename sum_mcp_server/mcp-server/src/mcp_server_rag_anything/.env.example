# RAG Anything MCP Server 配置示例（请复制为 .env 并填入真实值）

# 工作目录：指向 LightRAG 存储目录
RAG_WORKING_DIR=../../anything-chat-rag/rag_storage

# LLM 配置
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型（可选）
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815

# 向量嵌入配置
EMBEDDING_HOST=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# 解析器配置
RAG_PARSER=docling
RAG_PARSE_METHOD=auto

# 功能开关
RAG_ENABLE_IMAGE=true
RAG_ENABLE_TABLE=true
RAG_ENABLE_EQUATION=true
LOAD_EXISTING=true

# 向量存储（按需启用）
# LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
# VECTOR_STORAGE=MilvusVectorDBStorage
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=lightrag

