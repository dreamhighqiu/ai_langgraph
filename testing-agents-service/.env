# ==============================================================================
# 环境变量配置文件
# ==============================================================================
#
# ⚠️ 重要提示：根据部署方式选择正确的配置
#
# 1. Docker 部署（所有服务在容器中）：
#    - 使用容器名（如 milvus, redis, ollama）
#    - 使用容器内部端口（如 Redis 6379）
#
# 2. 本地开发（Agent 在宿主机，依赖服务在 Docker）：
#    - 使用 localhost 或 127.0.0.1
#    - 使用宿主机映射端口（如 Redis 6380）
#
# 详细说明请参考: DOCKER_DEPLOYMENT_CONFIG.md
#
# ==============================================================================

# ==============================================================================
# LLM 配置（统一管理所有 Agent 使用的大模型）
# ==============================================================================

# ---------- OpenAI 配置（主要使用） ----------
# OpenAI API Key
OPENAI_API_KEY=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

# OpenAI 模型名称（默认: gpt-4o）
OPENAI_MODEL=gpt-5.2

# OpenAI API Base URL（可选，用于自定义端点）
OPENAI_BASE_URL=https://us.api.openai.com/v1

# ---------- DeepSeek 配置（备用） ----------
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-f868dcc5b0494e6081ff89f08584b187

# DeepSeek 模型名称（默认: deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API Base URL（可选，用于自定义端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- Anthropic 配置（备用） ----------
# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Anthropic 模型名称（默认: claude-3-5-sonnet-20241022）
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------- 默认 LLM 提供商 ----------
# 可选值: openai, deepseek, anthropic
# 所有 Agent 默认使用此提供商，除非单独指定
DEFAULT_LLM_PROVIDER=deepseek

# ---------- 豆包（Doubao）配置（用于视觉和 PDF 多模态） ----------
# 豆包 API Key（用于图片识别和 PDF 多模态解析）
DOUBAO_API_KEY=your-doubao-api-key

# ==============================================================================
# RAG 和 MCP 服务配置
# ==============================================================================

# ---------- RAG Anything MCP 配置 ----------
# RAG 工作目录
RAG_WORKING_DIR=./rag_storage

# RAG 解析器（可选: docling, mineru, auto）
RAG_PARSER=docling

# RAG 解析方法
RAG_PARSE_METHOD=auto

# RAG 功能开关
RAG_ENABLE_IMAGE=true
RAG_ENABLE_TABLE=true
RAG_ENABLE_EQUATION=true
RAG_LOAD_EXISTING=true

# RAG 并发文件数
RAG_MAX_CONCURRENT=2

# ---------- LLM 配置（用于 RAG MCP 服务） ----------
# LLM 提供商
LLM_PROVIDER=openai

# LLM 模型
LLM_MODEL=gpt-5.2

# LLM API Key（可复用上面的 DEEPSEEK_API_KEY 或 OPENAI_API_KEY）
LLM_API_KEY=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

# LLM Base URL
LLM_BASE_URL=https://us.api.openai.com/v1

# LLM 温度参数
LLM_TEMPERATURE=0.7

# LLM 最大 Token 数
LLM_MAX_TOKENS=4096

# ---------- Vision 模型配置（可选） ----------
# Vision API Key（如未设置则使用 LLM_API_KEY）
VISION_API_KEY=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

# Vision Base URL
VISION_BASE_URL=https://us.api.openai.com/v1

# Vision 模型名称
VISION_MODEL=gpt-5.2

# Vision 提供商
VISION_PROVIDER=openai

# ---------- Embedding 配置 ----------
# 是否使用 Ollama Embedding
USE_OLLAMA_EMBEDDING=true

# Embedding 模型
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Embedding 服务地址
# 📦 Docker 部署: http://ollama:11434
# 💻 本地开发: http://localhost:11434
EMBEDDING_HOST=http://localhost:11434

# Embedding 维度
EMBEDDING_DIM=1024

# ---------- MCP 服务端点配置 ----------
# RAG Query MCP 服务地址
# 📦 Docker 部署: http://rag-query-mcp:8002/sse
# 💻 本地开发: http://127.0.0.1:8002/sse
RAG_QUERY_MCP_URL=http://127.0.0.1:8002/sse

# RAG Anything MCP 服务地址
# 📦 Docker 部署: http://rag-anything-mcp:8001/sse
# 💻 本地开发: http://localhost:8001/sse
RAG_ANYTHING_MCP_URL=http://localhost:8001/sse

# Pytest MCP 服务地址
# 📦 Docker 部署: http://pytest-mcp:8004/sse
# 💻 本地开发: http://127.0.0.1:8004/sse
PYTEST_MCP_URL=http://127.0.0.1:8004/sse

# Chrome MCP 服务地址
CHROME_MCP_URL=http://localhost:9222/sse

# ---------- RAG Anything 服务器配置 ----------
# 服务器主机
SERVER_HOST=0.0.0.0

# 服务器端口
SERVER_PORT=8001

# SSE 模式
SERVER_SSE_MODE=true

# 调试模式
DEBUG=false

# ---------- Midscene MCP 配置 ----------
# Midscene 模型配置（用于 Midscene 浏览器自动化）
MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MIDSCENE_MODEL_API_KEY=your-midscene-api-key
MIDSCENE_MODEL_NAME=doubao-seed-1-8-251215
MIDSCENE_MODEL_FAMILY=doubao-vision
MCP_SERVER_REQUEST_TIMEOUT=600000

# ---------- 向量存储配置 ----------
# 向量存储后端（可选: milvus, qdrant, neo4j 等）
LIGHTRAG_VECTOR_STORAGE=milvus
VECTOR_STORAGE=milvus

# Milvus 配置
# 📦 Docker 部署: http://milvus:19530
# 💻 本地开发: http://localhost:19530
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=default

# ==============================================================================
# 测试执行配置
# ==============================================================================

# ---------- Test Execution ----------
# 测试输出目录
TEST_OUTPUT_DIR=./test-output

# 并行测试工作线程数
PARALLEL_WORKERS=4

# 测试超时时间（秒）
TEST_TIMEOUT=300

# Allure 报告目录
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# ---------- API 测试 ----------
# API 测试报告输出目录
OUTPUT_DIR=./api-test-reports

# ---------- MCP 服务端口 ----------
# Pytest Generator MCP 端口
PYTEST_GENERATOR_PORT=8005

# Test Executor MCP 端口
TEST_EXECUTOR_PORT=8004

# RAG Server MCP 端口
RAG_SERVER_PORT=8002

# ==============================================================================
# LangGraph 服务配置
# ==============================================================================

# LangGraph 服务端口
LANGGRAPH_PORT=2025

# LangGraph API URL
LANGGRAPH_API_URL=http://localhost:2025

# ==============================================================================
# 日志配置
# ==============================================================================

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ==============================================================================
# 工作目录配置
# ==============================================================================

# PDF 多模态图片解析（需要配置 DOUBAO_API_KEY）
ENABLE_PDF_MULTIMODAL=true

# API 测试工作目录
API_WORKSPACE_ROOT=agents/api/workspace
API_SKILLS_ROOT=agents/api/agent_skills

# UI 测试工作目录（TypeScript/Playwright）
UI_WORKSPACE_ROOT=agents/ui/workspace
UI_SKILLS_ROOT=agents/ui/agent_skills

# UI Java 测试工作目录（Java/Playwright）
UI_JAVA_WORKSPACE_ROOT=agents/ui_java/workspace
UI_JAVA_SKILLS_ROOT=agents/ui_java/agent_skills

# 测试用例工作目录
TESTCASE_WORKSPACE_ROOT=agents/testcase/workspace
TESTCASE_SKILLS_ROOT=agents/testcase/agent_skills
