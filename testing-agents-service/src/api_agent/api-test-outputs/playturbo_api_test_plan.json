            "response contains save_id",
            "response contains timestamp"
          ]
        },
        {
          "test_case_id": "GAME-004",
          "name": "加载游戏进度接口",
          "priority": "High",
          "preconditions": ["用户已登录", "有保存的游戏进度"],
          "test_steps": [
            "发送GET请求到 /api/v1/games/1/load",
            "验证响应状态码为200"
          ],
          "expected_result": "成功加载游戏进度",
          "assertions": [
            "status_code == 200",
            "response contains game_data",
            "response contains save_timestamp"
          ]
        },
        {
          "test_case_id": "GAME-005",
          "name": "获取游戏排行榜接口",
          "priority": "Medium",
          "preconditions": ["游戏有排行榜数据"],
          "test_steps": [
            "发送GET请求到 /api/v1/games/1/leaderboard",
            "验证响应状态码为200"
          ],
          "expected_result": "成功获取排行榜数据",
          "assertions": [
            "status_code == 200",
            "response is array",
            "each entry has rank, username, score"
          ]
        },
        {
          "test_case_id": "GAME-006",
          "name": "提交游戏分数接口",
          "priority": "High",
          "preconditions": ["用户已登录", "游戏ID=1存在"],
          "test_steps": [
            "发送POST请求到 /api/v1/games/1/score",
            "提供分数数据",
            "验证响应状态码为200"
          ],
          "expected_result": "分数提交成功",
          "assertions": [
            "status_code == 200",
            "response contains new_rank",
            "response contains total_score"
          ]
        }
      ],
      
      "social_features_module": [
